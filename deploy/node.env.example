# One board's settings for deploy/run_node.sh. Copy to deploy/node.env and edit.
# Plain KEY=VALUE lines: the file is both sourced by bash and passed to docker --env-file,
# so no quotes, no spaces around '=', no 'export'.

# Unique in the cluster. NODE_ID (1..254) defaults to the number NODE_NAME ends with.
NODE_NAME=edge-01
# NODE_ID=1

# The same image tag on all 12 boards (CONVENTIONS 8: cccp-node:p<protocol>-<git short hash>).
IMAGE=cccp-node:p4-0000000-arm64

# The same on all boards, different from any other ROS 2 system on the network.
ROS_DOMAIN_ID=10

# The interface on the cluster network (deploy/cyclonedds.xml).
CCCP_DDS_INTERFACE=wlan0
# default | true | spdp (false breaks discovery); decide with the field capture (deploy/README.md).
CCCP_DDS_MULTICAST=default
# CCCP_DDS_TRACE=config

# Jetson: must be cuda:0 (NVIDIA torch gives NaN for EfficientNet on the Jetson CPU).
COLLAB_DEVICE=cuda:0
UE_HTTP_PORT=18090
LOG_LEVEL=INFO

# AirSim input (leave AIRSIM_HOST empty for a board camera on IMAGE_TOPIC).
AIRSIM_HOST=
# AIRSIM_VEHICLE=Drone1
# AIRSIM_FETCH_MODE=each

# Host directory for the event journal (<dir>/journal/<NODE_NAME>.jsonl), mounted at the same path.
# CCCP_DATA_DIR=/var/lib/cccp

# Batch tasks (docs/推理任务集成.md); leave unset for the first field tests.
# CCCP_JOB_STORE=/mnt/cccp_jobs
