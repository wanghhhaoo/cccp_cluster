<?xml version="1.0"?>
<package format="3">
  <name>collab_inference</name>
  <version>0.1.0</version>
  <description>PKCI collaborative classification and PKCT collaborative tracking ROS 2 services.</description>
  <maintainer email="comp@example.com">CCCP Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>collab_inference_interfaces</depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
